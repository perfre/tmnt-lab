---
name: "{{ docker_atlassian_lab.project_name }}"

networks:
  frontend:
    driver: bridge
  database:
    external: {{ docker_atlassian_lab.database.network.external | ternary('true', 'false') }}
    name: "{{ docker_atlassian_lab.database.network.name }}"

services:
  jira:
    image: "{{ docker_atlassian_lab.jira.image }}"
    hostname: "{{ docker_atlassian_lab.jira.hostname }}"
    restart: "{{ docker_atlassian_lab.restart }}"
    pull_policy: "{{ docker_atlassian_lab.pull_policy }}"
    user: "2001:2001"
    init: true
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    environment:
      ATL_JDBC_URL: "jdbc:postgresql://{{ docker_atlassian_lab.database.jira.host }}:{{ docker_atlassian_lab.database.jira.port }}/{{ docker_atlassian_lab.database.jira.name }}"
      ATL_JDBC_USER: "{{ docker_atlassian_lab.database.jira.user }}"
      ATL_JDBC_PASSWORD: "${JIRA_DB_PASSWORD}"
      ATL_DB_DRIVER: org.postgresql.Driver
      ATL_DB_TYPE: postgres72
      ATL_PROXY_NAME: "{{ docker_atlassian_lab.jira.hostname }}"
      ATL_PROXY_PORT: "{{ docker_atlassian_lab.jira.https_port }}"
      ATL_TOMCAT_SCHEME: https
      ATL_TOMCAT_SECURE: "true"
      JVM_MINIMUM_MEMORY: "{{ docker_atlassian_lab.jira.min_memory }}"
      JVM_MAXIMUM_MEMORY: "{{ docker_atlassian_lab.jira.max_memory }}"
      TZ: "{{ docker_atlassian_lab.timezone }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/status >/dev/null"]
      start_period: 180s
      interval: 30s
      timeout: 10s
      retries: 20
    networks:
      - frontend
      - database
    volumes:
      - type: bind
        source: "{{ docker_atlassian_lab.jira.data_dir }}"
        target: /var/atlassian/application-data/jira
    mem_limit: "{{ docker_atlassian_lab.jira.memory_limit }}"
    cpus: "{{ docker_atlassian_lab.jira.cpus }}"
    pids_limit: {{ docker_atlassian_lab.jira.pids_limit }}

  confluence:
    image: "{{ docker_atlassian_lab.confluence.image }}"
    hostname: "{{ docker_atlassian_lab.confluence.hostname }}"
    restart: "{{ docker_atlassian_lab.restart }}"
    pull_policy: "{{ docker_atlassian_lab.pull_policy }}"
    user: "2002:2002"
    init: true
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    environment:
      ATL_JDBC_URL: "jdbc:postgresql://{{ docker_atlassian_lab.database.confluence.host }}:{{ docker_atlassian_lab.database.confluence.port }}/{{ docker_atlassian_lab.database.confluence.name }}"
      ATL_JDBC_USER: "{{ docker_atlassian_lab.database.confluence.user }}"
      ATL_JDBC_PASSWORD: "${CONFLUENCE_DB_PASSWORD}"
      ATL_DB_DRIVER: org.postgresql.Driver
      ATL_DB_TYPE: postgresql
      ATL_PROXY_NAME: "{{ docker_atlassian_lab.confluence.hostname }}"
      ATL_PROXY_PORT: "{{ docker_atlassian_lab.confluence.https_port }}"
      ATL_TOMCAT_SCHEME: https
      ATL_TOMCAT_SECURE: "true"
      JVM_MINIMUM_MEMORY: "{{ docker_atlassian_lab.confluence.min_memory }}"
      JVM_MAXIMUM_MEMORY: "{{ docker_atlassian_lab.confluence.max_memory }}"
      TZ: "{{ docker_atlassian_lab.timezone }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8090/status >/dev/null"]
      start_period: 180s
      interval: 30s
      timeout: 10s
      retries: 20
    networks:
      - frontend
      - database
    volumes:
      - type: bind
        source: "{{ docker_atlassian_lab.confluence.data_dir }}"
        target: /var/atlassian/application-data/confluence
    mem_limit: "{{ docker_atlassian_lab.confluence.memory_limit }}"
    cpus: "{{ docker_atlassian_lab.confluence.cpus }}"
    pids_limit: {{ docker_atlassian_lab.confluence.pids_limit }}

  tls-proxy:
    image: "{{ docker_atlassian_lab.proxy.image }}"
    restart: "{{ docker_atlassian_lab.restart }}"
    pull_policy: "{{ docker_atlassian_lab.pull_policy }}"
    user: "101:101"
    read_only: true
    init: true
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    depends_on:
      jira:
        condition: service_healthy
      confluence:
        condition: service_healthy
    networks:
      - frontend
    ports:
      - name: jira-https
        target: 8443
        published: {{ docker_atlassian_lab.jira.https_port }}
        host_ip: "{{ docker_atlassian_lab.bind_address }}"
        protocol: tcp
      - name: confluence-https
        target: 8444
        published: {{ docker_atlassian_lab.confluence.https_port }}
        host_ip: "{{ docker_atlassian_lab.bind_address }}"
        protocol: tcp
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          wget -qO- https://127.0.0.1:8443/nginx-health >/dev/null
      start_period: 10s
      interval: 30s
      timeout: 5s
      retries: 5
    volumes:
      - type: bind
        source: "{{ docker_atlassian_lab.project_dir }}/nginx.conf"
        target: /etc/nginx/nginx.conf
        read_only: true
      - type: bind
        source: "{{ docker_atlassian_lab.pki.dir }}/ca.crt"
        target: /etc/ssl/certs/ca-certificates.crt
        read_only: true
      - type: bind
        source: "{{ docker_atlassian_lab.pki.dir }}/atlassian-lab.crt"
        target: /etc/nginx/tls/atlassian-lab.crt
        read_only: true
      - type: bind
        source: "{{ docker_atlassian_lab.pki.dir }}/atlassian-lab.key"
        target: /etc/nginx/tls/atlassian-lab.key
        read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    mem_limit: "{{ docker_atlassian_lab.proxy.memory_limit }}"
    cpus: "{{ docker_atlassian_lab.proxy.cpus }}"
    pids_limit: {{ docker_atlassian_lab.proxy.pids_limit }}
