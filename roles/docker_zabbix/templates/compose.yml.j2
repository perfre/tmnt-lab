---
name: "{{ docker_zabbix.project_name }}"

networks:
  zabbix:
    driver: bridge
  database:
    external: {{ docker_zabbix.database.network.external | ternary('true', 'false') }}
    name: "{{ docker_zabbix.database.network.name }}"

services:
  zabbix-server:
    image: "{{ docker_zabbix.server.image }}:{{ docker_zabbix.version_tag }}"
    restart: "{{ docker_zabbix.restart }}"
    pull_policy: "{{ docker_zabbix.pull_policy }}"
    environment:
      DB_SERVER_HOST: "{{ docker_zabbix.database.host }}"
      DB_SERVER_PORT: "{{ docker_zabbix.database.port }}"
      POSTGRES_DB: "{{ docker_zabbix.database.name }}"
      POSTGRES_USER: "{{ docker_zabbix.database.user }}"
      POSTGRES_PASSWORD: "{{ docker_zabbix.database.password }}"
{% for key, value in docker_zabbix.server.env.items() %}
      {{ key }}: {{ value | to_json }}
{% endfor %}
    networks:
      - zabbix
      - database
{% if docker_zabbix.server.ports | length > 0 %}
    ports:
{% for port in docker_zabbix.server.ports %}
      - "{{ port }}"
{% endfor %}
{% endif %}
    volumes:
      - type: bind
        source: "{{ docker_zabbix.server.data_dir }}"
        target: /var/lib/zabbix
{% for mount in docker_zabbix.plugin_mounts %}
      - type: bind
        source: "{{ mount.source }}"
        target: "{{ mount.target }}"
        read_only: {{ mount.read_only | default(true) | ternary('true', 'false') }}
{% endfor %}

  zabbix-web:
    image: "{{ docker_zabbix.web.image }}:{{ docker_zabbix.version_tag }}"
    restart: "{{ docker_zabbix.restart }}"
    pull_policy: "{{ docker_zabbix.pull_policy }}"
    depends_on:
      zabbix-server:
        condition: service_started
    environment:
      DB_SERVER_HOST: "{{ docker_zabbix.database.host }}"
      DB_SERVER_PORT: "{{ docker_zabbix.database.port }}"
      POSTGRES_DB: "{{ docker_zabbix.database.name }}"
      POSTGRES_USER: "{{ docker_zabbix.database.user }}"
      POSTGRES_PASSWORD: "{{ docker_zabbix.database.password }}"
      ZBX_SERVER_HOST: zabbix-server
      PHP_TZ: "{{ docker_zabbix.timezone }}"
{% for key, value in docker_zabbix.web.env.items() %}
      {{ key }}: {{ value | to_json }}
{% endfor %}
    networks:
      - zabbix
      - database
    ports:
      - "{{ docker_zabbix.web.http_port }}:8080"
{% if docker_zabbix.web.https_port %}
      - "{{ docker_zabbix.web.https_port }}:8443"
{% endif %}
{% if docker_zabbix.web.volumes | length > 0 %}
    volumes:
{% for mount in docker_zabbix.web.volumes %}
      - type: bind
        source: "{{ mount.source }}"
        target: "{{ mount.target }}"
        read_only: {{ mount.read_only | default(true) | ternary('true', 'false') }}
{% endfor %}
{% endif %}

{% if docker_zabbix.agent.enabled | bool %}
  zabbix-agent2:
    image: "{{ docker_zabbix.agent.image }}:{{ docker_zabbix.version_tag }}"
    restart: "{{ docker_zabbix.restart }}"
    pull_policy: "{{ docker_zabbix.pull_policy }}"
    environment:
      ZBX_HOSTNAME: "{{ docker_zabbix.agent.hostname }}"
      ZBX_SERVER_HOST: zabbix-server
      ZBX_SERVER_ACTIVE: zabbix-server
{% for key, value in docker_zabbix.agent.env.items() %}
      {{ key }}: {{ value | to_json }}
{% endfor %}
    networks:
      - zabbix
{% if docker_zabbix.agent.plugin_mounts | length > 0 %}
    volumes:
{% for mount in docker_zabbix.agent.plugin_mounts %}
      - type: bind
        source: "{{ mount.source }}"
        target: "{{ mount.target }}"
        read_only: {{ mount.read_only | default(true) | ternary('true', 'false') }}
{% endfor %}
{% endif %}
{% endif %}
