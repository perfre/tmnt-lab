[Unit]
Description=PowerDNS authoritative Docker Compose lab
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ docker_powerdns.project_dir }}
ExecStart={{ docker_powerdns.docker_binary }} compose -f {{ docker_powerdns.project_dir }}/compose.yml up -d --pull {{ docker_powerdns.pull_policy }} --remove-orphans
ExecStop={{ docker_powerdns.docker_binary }} compose -f {{ docker_powerdns.project_dir }}/compose.yml down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
