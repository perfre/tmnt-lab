[Unit]
Description=Ollama Server Docker Compose project
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ docker_ollama_server.project_dir }}
ExecStart={{ docker_ollama_server.docker_binary }} compose -f {{ docker_ollama_server.project_dir }}/compose.yml up -d --pull {{ docker_ollama_server.pull_policy }} --remove-orphans
ExecStop={{ docker_ollama_server.docker_binary }} compose -f {{ docker_ollama_server.project_dir }}/compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
