---
name: "{{ docker_postgres.project_name }}"

networks:
  database:
    name: "{{ docker_postgres.network.name }}"
    driver: bridge
    internal: true
  admin:
    name: "{{ docker_postgres.admin_network.name }}"
    driver: bridge
    internal: false

secrets:
  postgres_password:
    file: ./postgres-password

services:
  postgres:
    image: "{{ docker_postgres.image }}"
    restart: "{{ docker_postgres.restart }}"
    pull_policy: "{{ docker_postgres.pull_policy }}"
    user: "999:999"
    read_only: true
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    environment:
      POSTGRES_USER: "{{ docker_postgres.admin_user }}"
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    secrets:
      - postgres_password
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -q -t 2 -U $$POSTGRES_USER"]
      start_period: 20s
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      database:
        aliases:
          - "{{ docker_postgres.network.alias }}"
      admin:
        aliases:
          - "{{ docker_postgres.admin_network.alias }}"
    ports:
      - name: postgres-admin
        target: 5432
        published: {{ docker_postgres.listen_port }}
        host_ip: "{{ docker_postgres.bind_address }}"
        protocol: tcp
    volumes:
      - type: bind
        source: "{{ docker_postgres.data_dir }}"
        target: /var/lib/postgresql/data
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
      - /run/postgresql:rw,noexec,nosuid,size=16m,uid=999,gid=999
    mem_limit: "{{ docker_postgres.resources.memory_limit }}"
    cpus: "{{ docker_postgres.resources.cpus }}"
    pids_limit: {{ docker_postgres.resources.pids_limit }}
