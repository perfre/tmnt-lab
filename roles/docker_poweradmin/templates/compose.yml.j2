---
name: "{{ docker_poweradmin.project_name }}"

networks:
{% if docker_poweradmin.web.publish | bool %}
  ingress:
    driver: bridge
{% endif %}
  frontend:
    driver: bridge
    internal: true
  database:
    external: {{ docker_poweradmin.database.network.external | ternary('true', 'false') }}
    name: "{{ docker_poweradmin.database.network.name }}"
  powerdns_api:
    external: {{ docker_poweradmin.powerdns_api.network.external | ternary('true', 'false') }}
    name: "{{ docker_poweradmin.powerdns_api.network.name }}"
{% if docker_poweradmin.ldap.enabled | bool %}
  ldap:
    external: {{ docker_poweradmin.ldap.network.external | ternary('true', 'false') }}
    name: "{{ docker_poweradmin.ldap.network.name }}"
{% endif %}

secrets:
  db_password:
    file: ./secrets/db-password
  pdns_api_key:
    file: ./secrets/pdns-api-key
  admin_password:
    file: ./secrets/admin-password
  session_key:
    file: ./secrets/session-key
{% if docker_poweradmin.ldap.enabled | bool %}
  ldap_bind_password:
    file: ./secrets/ldap-bind-password
{% endif %}

services:
  poweradmin:
    image: "{{ docker_poweradmin.image }}"
    restart: "{{ docker_poweradmin.restart }}"
    pull_policy: "{{ docker_poweradmin.pull_policy }}"
    user: "{{ docker_poweradmin.run_uid }}:{{ docker_poweradmin.run_gid }}"
    read_only: true
    init: true
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    environment:
      TZ: "{{ docker_poweradmin.timezone }}"
      SERVER_PORT: "{{ docker_poweradmin.app_port }}"
      DB_TYPE: "{{ docker_poweradmin.database.type }}"
      DB_HOST: "{{ docker_poweradmin.database.host }}"
      DB_PORT: "{{ docker_poweradmin.database.port }}"
      DB_USER: "{{ docker_poweradmin.database.user }}"
      DB_PASS__FILE: /run/secrets/db_password
      DB_NAME: "{{ docker_poweradmin.database.name }}"
      PA_INIT_PDNS_SCHEMA: "{{ docker_poweradmin.database.init_pdns_schema | ternary('true', 'false') }}"
      PA_CREATE_ADMIN: "{{ docker_poweradmin.admin.create | ternary('true', 'false') }}"
      PA_ADMIN_USERNAME: "{{ docker_poweradmin.admin.username }}"
      PA_ADMIN_PASSWORD__FILE: /run/secrets/admin_password
      PA_ADMIN_EMAIL: "{{ docker_poweradmin.admin.email }}"
      PA_ADMIN_FULLNAME: "{{ docker_poweradmin.admin.full_name }}"
      PA_SESSION_KEY__FILE: /run/secrets/session_key
      PA_PDNS_API_URL: "{{ docker_poweradmin.powerdns_api.url }}"
      PA_PDNS_API_KEY__FILE: /run/secrets/pdns_api_key
      PA_PASSWORD_ENCRYPTION: "{{ docker_poweradmin.security.password_encryption }}"
      PA_LOGIN_TOKEN_VALIDATION: "{{ docker_poweradmin.security.login_token_validation | ternary('true', 'false') }}"
      PA_GLOBAL_TOKEN_VALIDATION: "{{ docker_poweradmin.security.global_token_validation | ternary('true', 'false') }}"
      PA_MFA_ENABLED: "{{ docker_poweradmin.security.mfa_enabled | ternary('true', 'false') }}"
      PA_LOCKOUT_ENABLED: "{{ docker_poweradmin.security.lockout_enabled | ternary('true', 'false') }}"
      PA_LOCKOUT_ATTEMPTS: "{{ docker_poweradmin.security.lockout_attempts }}"
      PA_LOCKOUT_DURATION: "{{ docker_poweradmin.security.lockout_duration }}"
      PA_TIMEZONE: "{{ docker_poweradmin.timezone }}"
{% if docker_poweradmin.ldap.enabled | bool %}
      PA_LDAP_ENABLED: "true"
      PA_LDAP_URI: "{{ docker_poweradmin.ldap.uri }}"
      PA_LDAP_BASE_DN: "{{ docker_poweradmin.ldap.base_dn }}"
      PA_LDAP_BIND_DN: "{{ docker_poweradmin.ldap.bind_dn }}"
      PA_LDAP_BIND_PASSWORD__FILE: /run/secrets/ldap_bind_password
      PA_LDAP_USER_ATTRIBUTE: "{{ docker_poweradmin.ldap.user_attribute }}"
      PA_LDAP_SEARCH_FILTER: "{{ docker_poweradmin.ldap.search_filter }}"
      PA_LDAP_PROTOCOL_VERSION: "{{ docker_poweradmin.ldap.protocol_version }}"
      PA_LDAP_SYNC_USER_INFO: "{{ docker_poweradmin.ldap.sync_user_info | ternary('true', 'false') }}"
      PA_LDAP_AUTO_PROVISION: "{{ docker_poweradmin.ldap.auto_provision | ternary('true', 'false') }}"
      PA_LDAP_GROUPS_ATTRIBUTE: "{{ docker_poweradmin.ldap.groups_attribute }}"
{% if docker_poweradmin.ldap.permission_template_mapping | length > 0 %}
      PA_LDAP_PERMISSION_TEMPLATE_MAPPING: "{{ docker_poweradmin.ldap.permission_template_mapping }}"
{% endif %}
{% if docker_poweradmin.ldap.group_mapping | length > 0 %}
      PA_LDAP_GROUP_MAPPING: "{{ docker_poweradmin.ldap.group_mapping }}"
{% endif %}
{% if docker_poweradmin.ldap.default_permission_template | length > 0 %}
      PA_LDAP_DEFAULT_PERMISSION_TEMPLATE: "{{ docker_poweradmin.ldap.default_permission_template }}"
{% endif %}
{% if docker_poweradmin.ldap.validate_certs | bool %}
      LDAPTLS_CACERT: "{{ docker_poweradmin.ldap.ca_container_path }}"
      LDAPTLS_REQCERT: demand
{% endif %}
{% endif %}
      DNS_NS1: "{{ docker_poweradmin.dns.ns1 }}"
      DNS_NS2: "{{ docker_poweradmin.dns.ns2 }}"
      DNS_HOSTMASTER: "{{ docker_poweradmin.dns.hostmaster }}"
    secrets:
      - source: db_password
        target: db_password
        uid: "{{ docker_poweradmin.run_uid }}"
        gid: "{{ docker_poweradmin.run_gid }}"
        mode: 0440
      - source: pdns_api_key
        target: pdns_api_key
        uid: "{{ docker_poweradmin.run_uid }}"
        gid: "{{ docker_poweradmin.run_gid }}"
        mode: 0440
      - source: admin_password
        target: admin_password
        uid: "{{ docker_poweradmin.run_uid }}"
        gid: "{{ docker_poweradmin.run_gid }}"
        mode: 0440
      - source: session_key
        target: session_key
        uid: "{{ docker_poweradmin.run_uid }}"
        gid: "{{ docker_poweradmin.run_gid }}"
        mode: 0440
{% if docker_poweradmin.ldap.enabled | bool %}
      - source: ldap_bind_password
        target: ldap_bind_password
        uid: "{{ docker_poweradmin.run_uid }}"
        gid: "{{ docker_poweradmin.run_gid }}"
        mode: 0440
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:{{ docker_poweradmin.app_port }}/ >/dev/null"]
      start_period: 30s
      interval: 30s
      timeout: 5s
      retries: 10
    networks:
      - frontend
      - database
      - powerdns_api
{% if docker_poweradmin.ldap.enabled | bool %}
      - ldap
{% endif %}
{% if docker_poweradmin.ldap.enabled | bool and docker_poweradmin.ldap.validate_certs | bool %}
    volumes:
      - type: bind
        source: "{{ docker_poweradmin.ldap.ca_path }}"
        target: "{{ docker_poweradmin.ldap.ca_container_path }}"
        read_only: true
{% endif %}
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m,uid={{ docker_poweradmin.run_uid }},gid={{ docker_poweradmin.run_gid }}
      - /app/config:rw,noexec,nosuid,size=16m,uid={{ docker_poweradmin.run_uid }},gid={{ docker_poweradmin.run_gid }}
      - /app/var:rw,noexec,nosuid,size=128m,uid={{ docker_poweradmin.run_uid }},gid={{ docker_poweradmin.run_gid }}
      - /var/caddy:rw,noexec,nosuid,size=16m,uid={{ docker_poweradmin.run_uid }},gid={{ docker_poweradmin.run_gid }}
    mem_limit: "{{ docker_poweradmin.resources.memory_limit }}"
    cpus: "{{ docker_poweradmin.resources.cpus }}"
    pids_limit: {{ docker_poweradmin.resources.pids_limit }}

  tls-proxy:
    image: "{{ docker_poweradmin.proxy.image }}"
    restart: "{{ docker_poweradmin.restart }}"
    pull_policy: "{{ docker_poweradmin.pull_policy }}"
    user: "101:101"
    read_only: true
    init: true
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    depends_on:
      poweradmin:
        condition: service_healthy
    networks:
{% if docker_poweradmin.web.publish | bool %}
      - ingress
{% endif %}
      - frontend
{% if docker_poweradmin.web.publish | bool %}
    ports:
      - name: poweradmin-https
        target: {{ docker_poweradmin.web.https_port }}
        published: {{ docker_poweradmin.web.https_port }}
        host_ip: "{{ docker_poweradmin.bind_address }}"
        protocol: tcp
{% endif %}
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          wget -qO- https://127.0.0.1:{{ docker_poweradmin.web.https_port }}/nginx-health >/dev/null
      start_period: 10s
      interval: 30s
      timeout: 5s
      retries: 5
    volumes:
      - type: bind
        source: "{{ docker_poweradmin.project_dir }}/nginx.conf"
        target: /etc/nginx/nginx.conf
        read_only: true
      - type: bind
        source: "{{ docker_poweradmin.pki.dir }}/ca.crt"
        target: /etc/ssl/certs/ca-certificates.crt
        read_only: true
      - type: bind
        source: "{{ docker_poweradmin.pki.dir }}/poweradmin.crt"
        target: /etc/nginx/tls/poweradmin.crt
        read_only: true
      - type: bind
        source: "{{ docker_poweradmin.pki.dir }}/poweradmin.key"
        target: /etc/nginx/tls/poweradmin.key
        read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    mem_limit: "{{ docker_poweradmin.proxy.memory_limit }}"
    cpus: "{{ docker_poweradmin.proxy.cpus }}"
    pids_limit: {{ docker_poweradmin.proxy.pids_limit }}
