[Unit]
Description=OpenBao Docker Compose project
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ docker_openbao.project_dir }}
ExecStart={{ docker_openbao.docker_binary }} compose -f {{ docker_openbao.project_dir }}/compose.yml up -d --pull {{ docker_openbao.pull_policy }} --remove-orphans
ExecStop={{ docker_openbao.docker_binary }} compose -f {{ docker_openbao.project_dir }}/compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
